# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sunrise Cafe

# ─── Razorpay ───────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── WhatsApp (Phase 2 — leave blank for now) ───────────────
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# ─── Optional: OpenWeatherMap (Phase 4) ─────────────────────
OPENWEATHER_API_KEY=

# ─── Smart Cafe: Auth (Module 9 — two flat credentials) ─────
# Secret used to sign the dashboard session cookie + menu-CRUD action
# token. Any long random string; rotate to invalidate all sessions.
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# ─── Smart Cafe: Payment (Module 5 / Pine Labs — mock for now) ─
# 'approved' | 'declined' | 'cancelled' — forces MockPaymentProvider's outcome.
MOCK_PAYMENT_OUTCOME=approved

# ─── Smart Cafe: Pine Labs (M6 — real integration, not yet used) ─
PINELABS_BASE_URL=https://www.plutuscloudserviceuat.in:8201
PINELABS_MERCHANT_ID=
PINELABS_SECURITY_TOKEN=
PINELABS_STORE_ID=
# ClientId of the A910S terminal assigned by Pine Labs when the device is registered
PINELABS_CLIENT_ID=
# Post Back URL to register with Pine Labs (your public HTTPS URL + this path):
# https://yourdomain.com/api/webhooks/pinelabs

# ─── Smart Cafe: Thermal Printers (58mm / Billing Buddy) ─────────────
#
# Option A — Bluetooth (Billing Buddy 58mm or any ESC/POS BT printer):
#   Run scripts/setup-bluetooth-printer.sh ONCE to pair & bind.
#   The script writes MAC + device path here automatically.
PRINTER_KITCHEN_BT_MAC=
PRINTER_KITCHEN_BT_DEVICE=/dev/rfcomm0
# Single printer? Set BEVERAGE_BT_MAC equal to KITCHEN_BT_MAC and leave
# BEVERAGE_BT_DEVICE blank — the app will route both to the same rfcomm device.
# Two printers? Set a different MAC and /dev/rfcomm1 for the beverage counter.
PRINTER_BEVERAGE_BT_MAC=
PRINTER_BEVERAGE_BT_DEVICE=
#
# Option B — Network/LAN ESC/POS printer (TCP port 9100):
#   Leave the BT vars blank and set these instead.
PRINTER_KITCHEN_IP=
PRINTER_BEVERAGE_IP=
#
# Priority: Bluetooth > Network > Mock (console log, default for dev)
