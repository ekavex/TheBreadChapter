# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres password — choose any strong password
POSTGRES_PASSWORD=change_me_strong_password

# Secret for signing session tokens — generate with:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=replace_with_64_hex_chars

# Public URL of the app (used for callbacks and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional — app branding ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=The Bread Chapter

# Port to expose on the host (default: 3000)
APP_PORT=3000

# ── Payment provider ──────────────────────────────────────────────────────────
# pinelabs = real terminal, mock = fake approvals (development only).
# In production this MUST be `pinelabs` with all credentials set; the app
# refuses to start on the mock provider when NODE_ENV=production.
PAYMENT_PROVIDER=mock

# Pine Labs Plutus Cloud credentials (from Pine Labs onboarding).
# BASE URL — UAT:  https://www.plutuscloudserviceuat.in:8201
#            PROD: confirm the exact host with Pine Labs before go-live.
PINELABS_MERCHANT_ID=
PINELABS_SECURITY_TOKEN=
PINELABS_STORE_ID=
PINELABS_BASE_URL=https://www.plutuscloudserviceuat.in:8201

# Shared secret for the Post Back (webhook) URL. Register the URL with Pine Labs
# as https://<your-domain>/api/webhooks/pinelabs?token=<this value>.
# Required in production — without it the webhook is rejected.
PINELABS_WEBHOOK_SECRET=

# Per-request timeout for Pine Labs HTTP calls (ms). GetStatus/Cancel are
# retried on timeout; UploadBilledTransaction never is (double-charge risk).
PINELABS_TIMEOUT_MS=15000

# Mock payment result when PAYMENT_PROVIDER=mock: approved | declined | cancelled
MOCK_PAYMENT_OUTCOME=approved

# ── Payment reconciliation sweep ──────────────────────────────────────────────
# Settles orders left in AWAITING_PAYMENT (lost webhook, closed tablet, restart).
RECONCILER_INTERVAL_MS=60000
# Set true only when an EXTERNAL cron drives /api/cron/reconcile-payments
# (required if you ever run more than one app instance).
RECONCILER_DISABLED=false
# Secret for POST /api/cron/reconcile-payments (Authorization: Bearer … or ?token=…)
CRON_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
# The seeded demo passwords (admin123 / manager123 / staff123) are rejected in
# production. Set to true only for a UAT box where they are acceptable.
ALLOW_DEFAULT_CREDENTIALS=false

# ── Optional — thermal printers ───────────────────────────────────────────────
# Priority: USB > Bluetooth > Network > Mock. Set only one method per station.
#
# USB (cable) — find device name with: ls /dev/usb/
PRINTER_KITCHEN_USB_DEVICE=
PRINTER_BEVERAGE_USB_DEVICE=
#
# Bluetooth (wireless) — RFCOMM; app auto-binds on first print if MAC is set
PRINTER_KITCHEN_BT_MAC=
PRINTER_KITCHEN_BT_DEVICE=
PRINTER_BEVERAGE_BT_MAC=
PRINTER_BEVERAGE_BT_DEVICE=
#
# Network TCP (port 9100)
PRINTER_KITCHEN_IP=
PRINTER_BEVERAGE_IP=

# ── Production infrastructure ─────────────────────────────────────────────────
# HTTPS reverse proxy (docker compose --profile tls up -d). Pine Labs requires a
# public HTTPS Post Back URL, so production needs these.
DOMAIN=
ACME_EMAIL=

# Nightly backups written to ./backups by the `backup` service.
BACKUP_RETENTION_DAYS=14

# Container memory ceilings.
APP_MEMORY_LIMIT=768m
DB_MEMORY_LIMIT=1g
